# ============================
# Minha Vitrine - Variáveis de Ambiente
# ============================
# Copie para .env e altere os valores

# Banco de Dados
MYSQL_ROOT_PASSWORD=TROQUE_SENHA_ROOT_FORTE
MYSQL_PASSWORD=TROQUE_SENHA_APP_FORTE

# JWT
JWT_SECRET=TROQUE_POR_CHAVE_SECRETA_COM_MAIS_DE_32_CARACTERES

# AWS (para deploy)
AWS_REGION=sa-east-1
AWS_ACCOUNT_ID=123456789012
EC2_KEY_NAME=minhavitrine-key
EC2_INSTANCE_TYPE=t3.small

# App Stores
APPLE_ID=seu@email.com
APPLE_TEAM_ID=XXXXXXXXXX
