{
  "cli": { "version": ">= 5.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "ios": { "image": "latest" }
    }
  },
  "submit": {
    "production": {
      "android": { "serviceAccountKeyPath": "./google-play-key.json", "track": "internal" },
      "ios": { "appleId": "SEU_APPLE_ID", "ascAppId": "SEU_ASC_APP_ID", "appleTeamId": "SEU_TEAM_ID" }
    }
  }
}
